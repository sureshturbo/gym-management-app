PORT=4100

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=gym_app

# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (the React dev server)
CORS_ORIGIN=http://localhost:5180,https://localhost:5180

# Hosted first run only: creates the first gym + owner if none exists yet
# OWNER_EMAIL=owner@example.com
# OWNER_PASSWORD=min-8-characters
# OWNER_NAME=Owner Name
# GYM_NAME=My Gym
